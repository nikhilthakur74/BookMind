# ===================================================================
# BookMind Environment Configuration Template
# Copy this file to backend/.env and replace placeholders with your actual values.
# NEVER commit .env to version control.
# ===================================================================

# Application
APP_NAME=BookMind API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api

# Server
HOST=127.0.0.1
PORT=8000

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# LLM Provider Selection: "ollama" (local), "groq" (cloud), or "mock" (offline testing)
LLM_PROVIDER=ollama
PROMPT_VERSION=v1.0

# Local Ollama LLM Configuration (Default local mode)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120.0
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=2048
OLLAMA_TEMPERATURE=0.1
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_CONCURRENT=1

# Groq LLM API (Preserved for cloud inference)
GROQ_API_KEY=gsk_your_groq_api_key_placeholder
GROQ_MODEL=llama-3.3-70b-versatile

# Qdrant Vector Database
# Leave QDRANT_URL empty to use local embedded persistent Qdrant (stores in data/qdrant_storage - zero Docker required)
# Or set to http://localhost:6333 for local Docker, or https://xyz.cloud.qdrant.io for Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=bookmind_chunks
QDRANT_STORAGE_DIR=data/qdrant_storage

# Embeddings (BGE-M3)
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# Storage Paths
UPLOAD_DIR=data/uploads
QDRANT_STORAGE_DIR=data/qdrant_storage
